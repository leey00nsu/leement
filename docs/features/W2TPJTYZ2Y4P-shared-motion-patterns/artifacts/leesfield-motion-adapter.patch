+import { useEffect, useRef, useState, type ReactNode } from "react";
+import { TextReveal } from "@/components/ui/text-reveal";
+import { RotatingContent } from "@/components/ui/rotating-content";
+// The product owns asset readiness and logo geometry; the registry owns rotation.
+export function LayoutTextFlip({ text, words, textGroups=[text], duration=1800, renderWord, paused=false }: { text: string; textGroups?: string[]; words: string[]; duration?: number; renderWord?: (word:string,index:number)=>ReactNode; paused?: boolean }) {
+ const slot=useRef<HTMLSpanElement>(null);
+ const [ready,setReady]=useState<number[]>([]);
+ const wordKey=words.join("|");
+ useEffect(()=>{
+  let cancelled=false;
+  const layers=Array.from(slot.current?.querySelectorAll<HTMLElement>("[data-logo-index]") ?? []);
+  Promise.all(layers.map(async layer=>{ try { await Promise.all(Array.from(layer.querySelectorAll("img")).map(image=>image.decode())); return Number(layer.dataset.logoIndex); } catch { return -1; } })).then(indexes=>{ if(!cancelled) setReady(indexes.filter(index=>index>=0)); });
+  return ()=>{cancelled=true;};
+ },[wordKey]);
+ const indexes=ready.length ? ready : words.map((_,index)=>index);
+ return <>
+  <span className="shrink-0">{textGroups.map((group,index)=><TextReveal.Item key={index} index={index}>{index>0 ? "\u00a0" : null}{group}</TextReveal.Item>)}</span>
+  <TextReveal.Item index={textGroups.length-1} ref={slot} className="inline-flex size-[0.85em] shrink-0 leading-none">
+   <RotatingContent label="Model logos" controls={false} paused={paused || ready.length<2} interval={duration} className="size-full [&>span]:size-full" items={indexes.map(index=><span key={words[index]} data-logo-index={index} className="flex size-full items-center justify-center">{renderWord ? renderWord(words[index],index) : words[index]}</span>)} />
+  </TextReveal.Item>
+ </>;
 }
