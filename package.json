{
  "name": "leement",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "turbo dev",
    "build": "pnpm build:tokens && pnpm build:theme && pnpm registry:build && turbo build",
    "build:tokens": "pnpm --filter @leement/tokens build",
    "build:theme": "pnpm --filter @leement/theme build",
    "registry:build": "shadcn build registry.json --output apps/docs/public/r",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint && eslint registry",
    "test": "vitest run",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@eslint/js": "^9.39.0",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^27.0.0",
    "lucide-react": "^0.562.0",
    "motion": "13.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.8.0",
    "shadcn": "^3.0.0",
    "sonner": "2.0.7",
    "tailwind-merge": "^3.7.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
